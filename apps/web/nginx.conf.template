# nginx config for serving the WorkHub SPA and proxying the API.
#
# This is an nginx *template*: the image entrypoint substitutes ${API_UPSTREAM}
# (default `api:3000`, set in the Dockerfile) at container start. nginx's own
# runtime variables ($host, $scheme, …) are left untouched.
#
# The SPA calls the API on relative /api/* paths and this proxy forwards them,
# so the static bundle contains no environment-specific URL — the same
# immutable image runs everywhere (see docs/ARCHITECTURE.md). The owner's
# reverse proxy terminates TLS and forwards plain HTTP to this container.

# Preserve the original scheme from an upstream reverse proxy; fall back to
# the direct scheme when none is present (local compose without a proxy).
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  '' $scheme;
}

# Long-cache fingerprinted assets (their names change with their content). An
# empty value adds no header, so every other response is left alone.
map $uri $asset_cache_control {
  default '';
  ~^/assets/ 'public, max-age=31536000, immutable';
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Proxy settings for every location below that proxies to the API. They are
  # inherited because no location sets its own proxy_set_header.
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;

  # Same-origin API (auth cookies stay first-party; no CORS in production).
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
  }

  # The API's health probes live at the root, outside /api. Proxy the two exact
  # paths so an external uptime monitor gets the API's answer (503 when the
  # database is down, 502 when the API is) instead of the SPA's index.html.
  location = /health {
    proxy_pass http://${API_UPSTREAM};
  }

  location = /health/ready {
    proxy_pass http://${API_UPSTREAM};
  }

  # Fingerprinted assets. No add_header in here: a location that sets its own
  # add_header inherits none from the server block, which dropped the security
  # headers below. Their Cache-Control comes from $asset_cache_control instead.
  location /assets/ {
    try_files $uri =404;
  }

  # SPA fallback: route everything else to index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Baseline security headers (tune CSP once the app's origins are known).
  # Every response header is set here, at server level, and no location sets
  # add_header — otherwise that location loses all of them.
  add_header Cache-Control $asset_cache_control;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript application/xml;
}

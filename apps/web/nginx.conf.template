# nginx config for serving the WorkHub SPA and proxying the API.
#
# This is an nginx *template*: the image entrypoint substitutes ${API_UPSTREAM}
# (default `api:3000`, set in the Dockerfile) at container start. nginx's own
# runtime variables ($host, $scheme, …) are left untouched.
#
# The SPA calls the API on relative /api/* paths and this proxy forwards them,
# so the static bundle contains no environment-specific URL — the same
# immutable image runs everywhere (see docs/ARCHITECTURE.md). The owner's
# reverse proxy terminates TLS and forwards plain HTTP to this container.

# Preserve the original scheme from an upstream reverse proxy; fall back to
# the direct scheme when none is present (local compose without a proxy).
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  '' $scheme;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Same-origin API (auth cookies stay first-party; no CORS in production).
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # Long-cache fingerprinted assets.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # SPA fallback: route everything else to index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Baseline security headers (tune CSP once the app's origins are known).
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript application/xml;
}

// Prisma schema for the WorkHub API.
// Docs: https://www.prisma.io/docs
//
// Conventions: see docs/DATABASE.md. Columns are snake_case in the database
// (via @map/@@map) while Prisma fields stay camelCase. Timestamps are
// timestamptz (UTC). Primary keys are UUID v7 (time-ordered). Every table
// carries created_at/updated_at; mutable domain rows carry a soft-delete
// (deleted_at) and an optimistic-locking version.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth — ADR-0003, ADR-0016).
//
// These four models are Better Auth's core schema, adapted to the repo's DB
// conventions (snake_case columns, UUID v7 keys, timestamptz). Their rows are
// managed by the library, so they deliberately do NOT carry the soft-delete /
// version columns domain tables use. Field names must stay aligned with what
// Better Auth expects — check the upgrade notes before renaming anything.
//
// Domain tables reference `User.id` through an `owner_id` column — see the
// reference-feature template (`apps/api/examples/reference-feature/`).
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// No domain models yet — the real application starts from the auth schema
// above. The first feature adds the first domain model and its migration
// (`prisma migrate dev`). Use the reference-feature template in
// `apps/api/examples/reference-feature/` as the pattern to copy
// (see docs/REFERENCE_FEATURE.md).
// ---------------------------------------------------------------------------

// Reference model sketch (TEMPLATE — not part of the live schema).
// `pnpm gen:feature <entity>` renames it and appends it to
// apps/api/prisma/schema.prisma, adding the `User` back-relation. Follows
// docs/DATABASE.md: snake_case columns, UUID v7, timestamptz, soft delete,
// auditing, optimistic-locking version, owner-scoped indexes (ADR-0016).
//
// `owner` is a real foreign key to users.id. ON DELETE CASCADE because owner_id
// is true ownership (ADR-0016): deleting an account erases the user's data
// rather than blocking account deletion (docs/DATABASE.md → Constraints).

enum ReferenceItemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ReferenceItem {
  id          String              @id @default(uuid(7)) @db.Uuid
  ownerId     String              @map("owner_id") @db.Uuid
  name        String
  description String?
  status      ReferenceItemStatus @default(DRAFT)
  version     Int                 @default(1)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?             @map("created_by") @db.Uuid
  updatedBy   String?             @map("updated_by") @db.Uuid
  deletedAt   DateTime?           @map("deleted_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([ownerId, status])
  @@map("reference_items")
}

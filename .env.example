# =============================================================================
# Blank App — environment variable template
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# For production, provide these via your secrets manager or a server-side
# `.env.production` file (see the production block at the bottom).
# See docs/DEPLOYMENT.md and SECURITY.md.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Database (PostgreSQL / Prisma) -----------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Values used by docker compose to provision the local Postgres container.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- API (NestJS) ------------------------------------------------------------
API_PORT=3000
# Comma-separated list of allowed CORS origins. Only needed for cross-origin
# setups — the standard deployment is same-origin (web nginx proxies /api).
CORS_ORIGINS=http://localhost:5173
# Log level: fatal | error | warn | info | debug | trace | silent (default info).
LOG_LEVEL=info
# Rate limiting: window in seconds and max requests per window.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- Authentication (Better Auth) -------------------------------------------
# Generate a strong random secret, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-in-every-environment
# The public origin the app is served from (the web container / dev server —
# NOT the API port, since auth requests flow through the /api proxy).
BETTER_AUTH_URL=http://localhost:5173
# Rate limiting of /api/auth/* (Better Auth's limiter). Unset = on in production
# only; set true/false to force it.
# AUTH_RATE_LIMIT_ENABLED=true
# Comma-separated proxy IPs/CIDRs to skip when reading X-Forwarded-For, so each
# client gets its own rate-limit bucket. The compose files default this to the
# Docker network range; add your reverse proxy's IP if it runs on another host.
AUTH_TRUSTED_PROXIES=
# Public self-service sign-up (ADR-0018). Off by default — create accounts with
# `pnpm user:create`, reset passwords with `pnpm user:reset-password`. Set true
# only for apps anyone may join (and add email verification first).
AUTH_SIGNUP_ENABLED=false

# --- Web (Vite dev server only) ----------------------------------------------
# Where `pnpm dev` proxies /api/* requests (see apps/web/vite.config.ts).
# The production bundle needs no API URL — it always calls relative /api paths.
API_PROXY_TARGET=http://localhost:3000

# =============================================================================
# Production (docker-compose.prod.yml) — put these in `.env.production` on the
# server:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# =============================================================================
# The public origin your reverse proxy serves the app from.
# APP_ORIGIN=https://app.example.com
# Host port the web container binds — point your reverse proxy at it.
# WEB_PORT=8080
# Image coordinates published by the release workflow (docs/DEPLOYMENT.md).
# IMAGE_BASE=ghcr.io/huttonhomehub/workhub
# IMAGE_TAG=v0.2.0
# Secrets — REQUIRED, no defaults:
# POSTGRES_PASSWORD=<openssl rand -base64 24>
# BETTER_AUTH_SECRET=<openssl rand -base64 32>

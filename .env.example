# =============================================================================
# WorkHub — environment variable template
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# For production, provide these via your secrets manager or a server-side
# `.env.production` file (see the production block at the bottom).
# See docs/DEPLOYMENT.md and SECURITY.md.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Database (PostgreSQL / Prisma) -----------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Values used by docker compose to provision the local Postgres container.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- API (NestJS) ------------------------------------------------------------
API_PORT=3000
# Comma-separated origins the API trusts: CORS, and Better Auth's sign-in origin
# check. List every address you open the web app from — VS Code port forwarding
# can use https://localhost:5173, and browser Codespaces use
# https://<codespace>-5173.app.github.dev. Unlisted origins can't sign in.
CORS_ORIGINS=http://localhost:5173,https://localhost:5173
# Log level: fatal | error | warn | info | debug | trace | silent (default info).
LOG_LEVEL=info
# Rate limiting: window in seconds and max requests per window.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- Authentication (Better Auth) -------------------------------------------
# Unset in development, the API uses a built-in insecure default. Anywhere real,
# set a random secret of at least 32 characters, e.g. `openssl rand -base64 32`:
# in production the API refuses to start with a shorter secret or a placeholder.
# BETTER_AUTH_SECRET=
# The public origin the app is served from (the web container / dev server —
# NOT the API port, since auth requests flow through the /api proxy).
BETTER_AUTH_URL=http://localhost:5173
# Rate limiting of /api/auth/* (Better Auth's limiter). Unset = on in production
# only; set true/false to force it.
# AUTH_RATE_LIMIT_ENABLED=true
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For hops are trusted (Better
# Auth and the API's rate limiter), so each client gets its own rate-limit
# bucket and can't spoof its address. Empty = trust no proxy (right for
# `pnpm dev`). The compose files default this to the Docker network range; add
# your reverse proxy's IP if it runs on another host.
AUTH_TRUSTED_PROXIES=
# Public self-service sign-up (ADR-0018). Off by default — create accounts with
# `pnpm user:create`, reset passwords with `pnpm user:reset-password`. Set true
# only for apps anyone may join (and add email verification first).
AUTH_SIGNUP_ENABLED=false

# --- Web (Vite dev server only) ----------------------------------------------
# Where `pnpm dev` proxies /api/* requests (see apps/web/vite.config.ts).
# The production bundle needs no API URL — it always calls relative /api paths.
API_PROXY_TARGET=http://localhost:3000

# =============================================================================
# Production (docker-compose.prod.yml) — put these in `.env.production` on the
# server:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# =============================================================================
# The public origin your reverse proxy serves the app from.
# APP_ORIGIN=https://app.example.com
# Host port the web container binds — point your reverse proxy at it.
# WEB_PORT=8080
# Host address that port binds to. Default 127.0.0.1: only a reverse proxy on
# the same host (not in a container) can reach it. Docker bypasses host
# firewalls, so widen it deliberately: a LAN/VPN IP of this host if the proxy
# runs on another machine, or the Docker bridge gateway (e.g. 172.17.0.1) for a
# proxy container on this host. Avoid 0.0.0.0 on an internet-facing host.
# WEB_BIND_ADDRESS=127.0.0.1
# Image coordinates published by the release workflow (docs/DEPLOYMENT.md).
# IMAGE_BASE=ghcr.io/huttonhomehub/workhub
# IMAGE_TAG=0.2.0
# Secrets — REQUIRED, no defaults:
# POSTGRES_PASSWORD=<openssl rand -base64 24>
# BETTER_AUTH_SECRET=<openssl rand -base64 32>

    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "eslint": "^9.18.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }

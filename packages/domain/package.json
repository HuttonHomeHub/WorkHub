{
  "name": "@repo/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure domain rules both apps run (ADR-0020 §5): the hours calculation engine and Europe/London time helpers on Temporal.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
